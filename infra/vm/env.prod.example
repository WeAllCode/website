# Keys for Secret Manager secret wac-env-prod (the whole file is one secret version).
# Real values never live in the repo. Build the env from these keys only; do not copy
# DATABASE_URL, SENDGRID_*, PAPERTRAIL_*, HEROKU_* or WEB_CONCURRENCY from Heroku (R15).
# Read by systemd (EnvironmentFile), never by a shell: no `export`, no quoting tricks.

SECRET_KEY=
DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=False
SITE_URL=https://www.weallcode.org

# gunicorn's Unix socket leaves REMOTE_ADDR empty; take the client IP from Cloudflare (443 only accepts Cloudflare).
ALLAUTH_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Postgres over the Unix socket with peer auth (no password, no DATABASE_URL).
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=wac
DB_USER=wac
DB_PASSWORD=

# Media and static (public GCS bucket, Terraform output).
GS_BUCKET_NAME=

EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=hello@weallcode.org
CONTACT_EMAIL=hello@weallcode.org

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# G-… GA4 measurement ID; set in wac-env-prod secret.
GA_MEASUREMENT_ID=

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# hooks.slack.com has no IPv6, so leave blank on this VM.
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=

# google-auth must reach the metadata server by name over IPv6, not 169.254.169.254 (R20).
GCE_METADATA_HOST=metadata.google.internal
GCE_METADATA_IP=metadata.google.internal
