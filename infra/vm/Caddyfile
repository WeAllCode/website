# Installed to /etc/caddy/Caddyfile by provision.sh (and by prod deploys when it changes).
# Cloudflare terminates public TLS and talks to this origin over IPv6 on :443 with the
# Cloudflare Origin CA certificate (Full (strict)). Nothing listens on :80.
{
	auto_https disable_redirects
}

(wac_common) {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	encode zstd gzip
	# Drop the "Via: 1.x Caddy" that reverse_proxy adds (a deletion, so it applies as the
	# response is written; header_down -Via inside reverse_proxy does not remove it).
	header -Via
	request_body {
		max_size 10MB
	}
}

# Inside each reverse_proxy. A deploy restarts gunicorn (~20 s with --preload on the e2-micro);
# its RuntimeDirectory and socket vanish meanwhile, so dials fail. Instead of an instant 502,
# hold the request and redial every 250ms for up to 30s (well under Cloudflare's 100s).
# Only failed dials are retried, so a request is never sent to gunicorn twice.
(wac_proxy) {
	header_up X-Forwarded-Proto https
	lb_try_duration 30s
	lb_try_interval 250ms
}

# Vulnerability-scanner probes (/.env, /.git/config, /backup.zip, /wp-login.php ...) get a tiny
# 404 here instead of reaching Django's 74 KB 404 page. The Cloudflare WAF rules
# (infra/terraform/waf.tf) are the first line; this catches what their no-regex expressions
# can't, plus anything that reaches the origin while a rule is disabled. RE2 has no lookahead,
# so /.well-known/, /robots.txt and /sitemap.xml are excluded with "not path". Cache-Control:
# private keeps the cache-plan invariant that only the Django middleware marks anything public.
# respond sorts before reverse_proxy, so a probe never reaches gunicorn.
# infra/vm/test-caddy-probes.sh extracts the block between the markers and tests it locally.
# BEGIN wac_probes
(wac_probes) {
	@probe {
		path_regexp probe (?i)(/\.|~$|\.(env|php\d?|phtml|asp|aspx|asax|asa|axd|jsp|cgi|sql|bak|backup|old|orig|save|swp|tmp|zip|tar|gz|tgz|rar|7z|log|ini|cnf|conf|config|cfg|pem|key|enc|kv|ya?ml|toml|properties|gradle|db|sqlite|tfstate|tfvars|hcl|ovpn|py|rb|lock|inc|json|js|map|xml|txt|md)$|^/(wp-|wordpress|xmlrpc|phpmyadmin|pma/|cgi-bin|vendor/|telescope|_ignition|_debugbar|@fs/|phpinfo|server-status|server-info|graphi?ql|horizon)|/actuator|/_profiler|/wp-|^/(dockerfile|makefile|jenkinsfile|procfile|gemfile|vagrantfile|rakefile|capfile|gulpfile|brewfile|pipfile|id_[rd]sa|id_ecdsa|env|direnv|credentials|error_log|kubeconfig|oai_config_list|passwd-s3fs|metrics|healthz?|_?status|_?info|_?version|oauth/token|v2/_catalog|api/(v1/)?config|api/health)/?$)
		not path /.well-known/* /robots.txt /sitemap.xml
	}
	header @probe Cache-Control "private"
	respond @probe "Not Found" 404
}
# END wac_probes

weallcode.org:443, www.weallcode.org:443, gcp.weallcode.org:443 {
	import wac_common
	# Probe block: see (wac_probes) above.
	import wac_probes
	reverse_proxy unix//run/wac-prod/gunicorn.sock {
		import wac_proxy
	}
}

staging.weallcode.org:443 {
	import wac_common
	# Probe block: see (wac_probes) above. basic_auth below still runs first (directive order).
	import wac_probes
	# Written by provision.sh from metadata key wac-staging-basic-auth: a basic_auth block with
	# a bcrypt hash (caddy hash-password). Falls back to a random password when the key is unset.
	import wac-staging-auth.caddy
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy unix//run/wac-staging/gunicorn.sock {
		import wac_proxy
	}
}
