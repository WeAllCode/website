# Keys for Secret Manager secret wac-env-staging (the whole file is one secret version).
# Real values never live in the repo. Build the env from these keys only; do not copy
# DATABASE_URL, SENDGRID_*, PAPERTRAIL_*, HEROKU_* or WEB_CONCURRENCY from Heroku (R15).
# Read by systemd (EnvironmentFile), never by a shell.
# GOOGLE_APPLICATION_CREDENTIALS is set by wac-staging.service and wac-manage; don't add it here.

# Its own key, never prod's.
SECRET_KEY=
DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=False
SITE_URL=https://staging.weallcode.org

# gunicorn's Unix socket leaves REMOTE_ADDR empty; take the client IP from Cloudflare (443 only accepts Cloudflare).
ALLAUTH_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Postgres over the Unix socket; Unix user wac-staging maps to role wac_staging (pg_ident).
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME=wac_staging
DB_USER=wac_staging
DB_PASSWORD=

# Staging media bucket (wac-staging-media-<project_id>).
GS_BUCKET_NAME=

# Must stay the console backend: deploy-pull.sh and refresh-staging-db.sh refuse anything else,
# so a copy of prod data can never email real people. No RESEND_API_KEY on staging.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@weallcode.org
CONTACT_EMAIL=hello@weallcode.org

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=

# google-auth must reach the metadata server by name over IPv6, not 169.254.169.254 (R20).
GCE_METADATA_HOST=metadata.google.internal
GCE_METADATA_IP=metadata.google.internal
